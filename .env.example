# Clerk authentication
# Publishable key is safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key must stay server-only. Never expose to the client.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity — project id and dataset are not secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-20
# Read token for the private dataset. Server-only — never expose to the client.
SANITY_API_READ_TOKEN=
